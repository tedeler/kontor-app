# Kontor – stündlicher Sicherungspunkt (betrieb.md 4.3, 8; sicherungspunkte.md 8). Gestartet von
# kontor-sicherung.timer und vor jedem Update (kontor-update.service).
# Braucht keine Geheimnisse: keine Credentials.
[Unit]
Description=Kontor – Sicherungspunkt in /var/lib/kontor/sicherungen
After=kontor.service

[Service]
Type=oneshot
User=kontor
Group=kontor
EnvironmentFile=/etc/kontor/kontor.env
ExecStart=/opt/kontor/venv/bin/python -m kontor.sicherung stunde --verzeichnis /var/lib/kontor/sicherungen
StateDirectory=kontor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
